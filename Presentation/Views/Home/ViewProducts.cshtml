@{
}

@model ProductListViewModel

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>In-Stock</th>
            <th>Category</th>
            <th>Description</th>
        </tr>
    </thead>
</table>

<tbody>
    @foreach (var product in Model.Products)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Price</td>
            <td>@product.Quantity</td>
            <td>@product.Category</td>
            <td>@product.Description</td>
        </tr>
    }
</tbody>

<label>Filter</label>



<label>Sort</label>
